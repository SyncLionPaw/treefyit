# Copy to .env and fill in values:
#   cp .env.example .env

# Required for semantic build mode, summarize, verify, and deepseek chat models
DEEPSEEK_API_KEY=sk-...

# Optional: other chat models (OpenAI-compatible)
# OPENAI_API_KEY=sk-...

# Optional: MinerU API for large PDFs (>10 MB / >20 pages)
# MINERU_TOKEN=...

# Optional: comma-separated CORS origins (default: * = allow all)
# TREEFYIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
